# LeadClaw Environment Variables
# Copy to .env and fill in your values

# ===========================================
# DATABASE (Neon PostgreSQL)
# ===========================================
# Get your connection string from https://neon.tech
# Format: postgresql://user:password@host/database
DATABASE_URL=

# ===========================================
# EMAIL - SENDGRID
# ===========================================
# Get API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Sender info (must be verified in SendGrid)
FROM_EMAIL=sales@helmsai.com
FROM_NAME=Kade @ Helms AI

# ===========================================
# EMAIL - IMAP (Reply Monitoring)
# ===========================================
# Your email provider's IMAP settings
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# ===========================================
# LEAD ENRICHMENT
# ===========================================
# Apollo.io API key (optional, for enrichment)
APOLLO_API_KEY=

# ===========================================
# NOTIFICATIONS
# ===========================================
# OpenClaw Gateway for notifications (optional)
OPENCLAW_GATEWAY=http://127.0.0.1:18789
OPENCLAW_TOKEN=

# Webhook URL for hot lead alerts (optional)
HANDOFF_WEBHOOK=

# ===========================================
# VERCEL DEPLOYMENT
# ===========================================
# These are set automatically by Vercel
# VERCEL_URL=
# VERCEL_ENV=
